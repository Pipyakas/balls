# Unity project outputs and local state.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]in/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Bb]uild/
/[Bb]uilds/
/Assets/AssetStoreTools*

# Generated solution and project files, plus IDE state.
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.vscode/
.idea/

# Crash reports and OS noise.
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.tmp
.DS_Store

# Native plugins are built by CMake, not committed as binaries.
/Assets/Plugins/x86_64/*.dll
/Assets/Plugins/x86_64/*.pdb
!/Assets/Plugins/x86_64/.gitkeep

# Generated by the editor on first open.
*.slnx

# Generated from data/assets by Balls/Set Up Project.
/Assets/StreamingAssets/levels/

# Editor and build logs, and performance-test drops.
*.log
/Assets/Resources/PerformanceTestRun*.json*
