{
  "FileVersion": 3,
  "EngineAssociation": "5.8",
  "Category": "",
  "Description": "Unreal Engine front end for Balls",
  "Plugins": [
    {
      "Name": "Box3DUnreal",
      "Enabled": false,
      "Optional": true
    },
    {
      "Name": "FlatNodes",
      "Enabled": false,
      "Optional": true
    },
    {
      "Name": "Flow",
      "Enabled": false,
      "Optional": true
    },
    {
      "Name": "TBImGui",
      "Enabled": false,
      "Optional": true
    },
    {
      "Name": "UE5Coro",
      "Enabled": false,
      "Optional": true
    },
    {
      "Name": "WcwMemoryMonitorModule",
      "Enabled": false,
      "Optional": true
    },
    {
      "Name": "XDash",
      "Enabled": false,
      "Optional": true
    }
  ],
  "Modules": [
    {
      "Name": "BallsRendering",
      "Type": "Runtime",
      "LoadingPhase": "PostConfigInit"
    },
    {
      "Name": "Balls",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    }
  ],
  "PreBuildSteps": {
    "Win64": [
      "\"$(ProjectDir)\\BuildCore.bat\""
    ],
    "Android": [
      "\"$(ProjectDir)\\BuildCoreAndroid.bat\""
    ],
    "Linux": [
      "\"$(ProjectDir)/BuildCoreLinux.sh\" \"$(EngineDir)\""
    ]
  }
}
